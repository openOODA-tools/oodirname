// # Aggregate Root Substrate Anchor
//
// Logline: Unified entry point for oodirname module test suite execution across path, render, and ipc.
//
// Setup: Demands zero ambient authority, links all functional module anchors together.
//
// Beats:
//   1. Execute path module anchor tests for POSIX dirname and basename compliance.
//   2. Execute render module anchor tests for text, zero mode, and JSON Lines.
//   3. Execute IPC module anchor tests for CLI options and streaming MCP protocol.
//   4. Return aggregate boolean pass/fail status.

import "path/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    if !run_path_tests() {
        return false;
    }
    if !run_render_tests() {
        return false;
    }
    if !run_ipc_tests() {
        return false;
    }
    return true;
}

