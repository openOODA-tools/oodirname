// # JSON Lines Formatter for Dirname
//
// Logline: Formats resolved path hierarchy and components into structured JSON Lines.
//
// Setup: Encodes path metadata including dirname, basename, depth, and root status.
//
// Beats:
//   1. Escape JSON strings for safe transmission.
//   2. Extract path components and compute tree depth.
//   3. Assemble JSON object string per path entry.
//   4. Format single or batch path records into streaming JSON Lines.

import "path/dirname_split.oo";
import "path/dirname_ancestors.oo";

pub fn escape_json_str(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(s, i);
        if b == 92 {
            out = out + "\\\\";
        } else if b == 34 {
            out = out + "\\\"";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

pub fn format_json_line(path: String) -> String {
    let comps: PathComponents = split_path_components(path);
    let depth: Int = count_path_depth(path);
    let is_root: Bool = comps.dir == "/";

    let mut out: String = "{";
    out = out + "\"path\":\"" + escape_json_str(path) + "\",";
    out = out + "\"dirname\":\"" + escape_json_str(comps.dir) + "\",";
    out = out + "\"basename\":\"" + escape_json_str(comps.base) + "\",";
    out = out + "\"depth\":" + depth.to_string() + ",";
    out = out + "\"is_root\":" + (if is_root { "true" } else { "false" });
    out = out + "}\n";
    return out;
}

pub fn format_json_batch(paths: List[String]) -> String {
    let n: Int = list_len(paths);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        out = out + format_json_line(list_get(paths, i));
        i = i + 1;
    }
    return out;
}
