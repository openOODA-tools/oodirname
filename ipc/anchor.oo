// # IPC Module Anchor
//
// Logline: Unified substrate verification anchor for oodirname IPC interfaces.
//
// Setup: Exports CLI options parser, JSON field extraction, and streaming MCP server.
//
// Beats:
//   1. Re-export IPC structures, parsers, and MCP request handlers.
//   2. Run internal anchor tests validating CLI options and JSON field parsing.
//   3. Assert MCP initialize and tool dispatch responses conform to specification.
//   4. Return boolean pass/fail status for IPC module test suite.

import "ipc/json_field.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";

pub fn run_ipc_tests() -> Bool {
    return test_ipc();
}

pub fn test_ipc() -> Bool {
    // 1. CLI options test
    let mut args: List[String] = list_new();
    args = list_push(args, "-z");
    args = list_push(args, "-j");
    args = list_push(args, "/usr/bin");
    args = list_push(args, "/etc/passwd");

    let opts: DirnameOpts = parse_cli_args(args);
    if !opts.zero_mode { return false; }
    if !opts.json_mode { return false; }
    if list_len(opts.paths) != 2 { return false; }
    if list_get(opts.paths, 0) != "/usr/bin" { return false; }
    if list_get(opts.paths, 1) != "/etc/passwd" { return false; }

    // 2. JSON field parsing test
    let sample_json: String = "{\"name\":\"dirname_resolve\",\"flag\":true,\"depth\":4,\"paths\":[\"a\",\"b\"]}";
    if json_extract_str_field(sample_json, "name") != "dirname_resolve" { return false; }
    if !json_extract_bool_field(sample_json, "flag", false) { return false; }
    if json_extract_int_field(sample_json, "depth", 0) != 4 { return false; }
    let list_res: List[String] = json_extract_str_list(sample_json, "paths");
    if list_len(list_res) != 2 { return false; }
    if list_get(list_res, 0) != "a" { return false; }

    // 3. MCP protocol response tests
    let init_resp: String = render_mcp_init("1");
    if !str_contains(init_resp, "\"name\":\"oodirname\"") { return false; }
    if !str_contains(init_resp, "\"version\":\"0.2.0\"") { return false; }

    let list_resp: String = render_mcp_tools_list("2");
    if !str_contains(list_resp, "dirname_resolve") { return false; }
    if !str_contains(list_resp, "dirname_batch") { return false; }
    if !str_contains(list_resp, "dirname_ancestors") { return false; }
    if !str_contains(list_resp, "dirname_split") { return false; }
    if !str_contains(list_resp, "dirname_demo") { return false; }

    return true;
}
