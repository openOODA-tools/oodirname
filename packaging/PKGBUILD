# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oodirname-bin
_pkgname=oodirname
pkgver=0.2.0
pkgrel=1
pkgdesc="Sovereign POSIX dirname and path directory stripper in pure openOODA."
arch=('x86_64')
url="https://github.com/openOODA-tools/oodirname"
license=('Apache-2.0')
depends=('glibc')
provides=('oodirname')
conflicts=('oodirname')
source_x86_64=("${url}/releases/download/v${pkgver}/oodirname-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oodirname-linux-x86_64" "${pkgdir}/usr/bin/oodirname"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oodirname-uninstall"
}
