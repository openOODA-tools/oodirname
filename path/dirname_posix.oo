// # POSIX Dirname Resolver
//
// Logline: Computes parent directory component of path strings complying with IEEE Std 1003.1.
//
// Setup: Pure string manipulation algorithm with zero system dependencies and zero ambient authority.
//
// Beats:
//   1. Handle empty strings and trailing slash normalization.
//   2. Identify root directory path boundaries.
//   3. Locate final path delimiter and truncate trailing component.
//   4. Normalize result returning dot for relative bare files or slash for root descendants.

pub fn posix_dirname(path: String) -> String {
    let n: Int = chars_len(path);
    if n == 0 {
        return ".";
    }

    // Step 1: Find last non-slash character
    let mut end: Int = n - 1;
    while end >= 0 && byte_at(path, end) == 47 {
        end = end - 1;
    }

    // If path consists entirely of slashes, POSIX requires "/"
    if end < 0 {
        return "/";
    }

    // Step 2: Slice off trailing slashes
    let trimmed: String = str_slice(path, 0, end + 1);
    let trimmed_len: Int = chars_len(trimmed);

    // Step 3: Find last slash in trimmed string
    let mut slash_idx: Int = -1;
    let mut i: Int = trimmed_len - 1;
    while i >= 0 {
        if byte_at(trimmed, i) == 47 {
            slash_idx = i;
            i = -1;
        } else {
            i = i - 1;
        }
    }

    // If no slash found, result is "."
    if slash_idx < 0 {
        return ".";
    }

    // If the only slash is the root slash, result is "/"
    if slash_idx == 0 {
        return "/";
    }

    // Step 4: Strip repeated slashes immediately preceding slash_idx
    let mut p_end: Int = slash_idx;
    while p_end > 0 && byte_at(trimmed, p_end - 1) == 47 {
        p_end = p_end - 1;
    }

    if p_end == 0 {
        return "/";
    }

    return str_slice(trimmed, 0, p_end);
}
